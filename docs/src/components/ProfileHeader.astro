---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photo = `${base}/assets/SatoshiIto.jpg`;

const profile = {
  name: 'Satoshi Ito',
  nameJa: '伊藤 哲',
};

interface LinkItem { label: string; href: string; icon: 'github' | 'linkedin' }
const links: LinkItem[] = [
  { label: 'GitHub',   href: 'https://github.com/pugsatoshi',           icon: 'github' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/satoshi-ito/', icon: 'linkedin' },
];
---
<section class="profile" id="top">
  <div class="shell profile-grid">
    <figure class="profile-photo">
      <img src={photo} alt={profile.name} width="360" height="360" />
    </figure>
    <div class="profile-body">
      <p class="profile-eyebrow">
        <span data-i18n="en">R&amp;D Group / Hitachi, Ltd.</span>
        <span data-i18n="ja">株式会社日立製作所 / 研究開発グループ</span>
      </p>
      <h1 class="profile-name">
        <span data-i18n="en">{profile.name}</span>
        <span data-i18n="ja">{profile.nameJa}</span>
        <span class="ja" data-i18n="en">{profile.nameJa}</span>
        <span class="ja" data-i18n="ja">{profile.name}</span>
      </h1>
      <ul class="profile-links">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={l.label}
              title={l.label}
            >
              {l.icon === 'github' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-1.96c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.4-5.26 5.69.41.35.78 1.04.78 2.1v3.11c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>
                </svg>
              )}
              {l.icon === 'linkedin' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.21 0 22.23 0z"/>
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
