---
import { publications } from '../data/publications';
import { talks as manualTalks, type Talk } from '../data/talks';

interface Props {
  limit?: number;
}
const { limit } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isPreview = typeof limit === 'number' && limit > 0;

const conferenceTalks: Talk[] = publications
  .filter((p) => p.type === 'Conference')
  .map((p) => ({
    date: String(p.year),
    title: p.title,
    venue: p.venue,
    type: 'Conference',
    link: p.links[0],
  }));

const sortKey = (d: string) => {
  const parts = d.split('.');
  const y = parseInt(parts[0] ?? '0', 10);
  const m = parseInt(parts[1] ?? '0', 10);
  const day = parseInt(parts[2] ?? '0', 10);
  return y * 10000 + m * 100 + day;
};

const merged: Talk[] = [...manualTalks, ...conferenceTalks].sort(
  (a, b) => sortKey(b.date) - sortKey(a.date)
);

const visible: Talk[] = isPreview ? merged.slice(0, limit) : merged;
---
<section class="section shell" id="talks">
  <div class="section-head">
    <h2>
      <span data-i18n="en">Talks &amp; lectures<span class="ja">発表・講演</span></span>
      <span data-i18n="ja">発表・講演<span class="ja">Talks &amp; lectures</span></span>
    </h2>
    <span class="aside">
      <span data-i18n="en">{merged.length} entries</span>
      <span data-i18n="ja">{merged.length} 件</span>
    </span>
  </div>
  <ol class="talk-list">
    {visible.map((t) => (
      <li class="talk-row">
        <span class="talk-date">{t.date}</span>
        <div class="talk-main">
          <p class="talk-title">{t.title}</p>
          <p class="talk-venue">
            {t.venue}
            {t.link && (
              <>
                {' · '}
                <a href={t.link.href} target="_blank" rel="noopener noreferrer">{t.link.label} ↗</a>
              </>
            )}
          </p>
        </div>
        <span class="talk-type kw">{t.type}</span>
      </li>
    ))}
  </ol>

  {isPreview && (
    <div class="pub-more">
      <a class="pub-more-link" href={`${base}/talks`}>
        <span data-i18n="en">View all talks →</span>
        <span data-i18n="ja">すべての発表・講演を見る →</span>
      </a>
    </div>
  )}
</section>
