---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import Bio from '../components/Bio.astro';
import Research from '../components/Research.astro';
import Publications from '../components/Publications.astro';
import Talks from '../components/Talks.astro';
import Awards from '../components/Awards.astro';
import News from '../components/News.astro';
import Experience from '../components/Experience.astro';
import Colophon from '../components/Colophon.astro';
---
<Base>
  <Masthead />
  <main>
    <ProfileHeader />
    <Bio />
    <Research />
    <News limit={2} />
    <Experience />
    <Publications limit={3} />
    <Talks limit={2} />
    <Awards limit={2} />
  </main>
  <Colophon />
</Base>
